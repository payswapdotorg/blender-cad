{
  "provenance": {
    "author": "TL2-W2 (history/naming lane)",
    "date": "2026-10-19",
    "license": "same as repo (experiments tree)"
  },
  "description": "W2 scenario 6: expensive features upstream (plate + all-edge fillet + 24-hole circular+rect pattern of holes) of a param-driven slot cut and a downstream hole; the edit script changes only slot_x",
  "commands": [
    {"command": "parameters.change", "params": {"name": "thick", "expression": "10 mm"}},
    {"command": "parameters.change", "params": {"name": "slot_x", "expression": "15 mm"}},
    {"command": "parameters.change", "params": {"name": "slot_w", "expression": "10 mm"}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "Plate"}},
    {"command": "sketch.rectangle.two_point", "params": {"p0": [0, 0], "p1": [80, 60]}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"distance": "thick", "name": "Plate"}},
    {"command": "solid.fillet", "params": {"edges": [[80, 30, 10], [80, 30, 0], [0, 30, 10], [0, 30, 0]], "radius": 4, "name": "LongEdges"}},
    {"command": "solid.hole", "params": {"position": [15, 12, 10], "diameter": 5, "name": "Hole1"}},
    {"command": "solid.pattern.rectangular", "params": {"features": ["Hole1"], "dir1": [1, 0, 0], "count1": 4, "spacing1": 15, "dir2": [0, 1, 0], "count2": 2, "spacing2": 20}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "Slot"}},
    {"command": "sketch.rectangle.two_point", "params": {"p0": [15, 20], "p1": [25, 40]}},
    {"command": "sketch.dimension", "params": {"entities": ["origin", "p1"], "type": "horizontal", "value": "slot_x"}},
    {"command": "sketch.dimension", "params": {"entities": ["l1"], "value": "slot_w"}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"sketch": "Slot", "distance": 12, "operation": "cut", "start_offset": 6, "name": "Pocket"}},
    {"command": "solid.hole", "params": {"position": [60, 45, 10], "diameter": 8, "name": "LateHole"}},
    {"command": "inspect.measure", "params": {}}
  ]
}
