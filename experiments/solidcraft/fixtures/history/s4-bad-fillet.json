  "description": "W2 scenario 4: a fillet radius that cannot be built (200 mm on a 10 mm edge) -> the command itself must fail and nothing may be written",
  "commands": [
    {"command": "sketch.create", "params": {"plane": "XY", "name": "S"}},
    {"command": "sketch.rectangle.two_point", "params": {"p0": [0, 0], "p1": [40, 30]}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"distance": 10, "name": "Block"}},
    {"command": "solid.fillet", "params": {"edges": [[40, 15, 10]], "radius": 200, "name": "TooBig"}}
  ]
}
